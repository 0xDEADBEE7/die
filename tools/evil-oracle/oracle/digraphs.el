;;; digraphs.el --- Write die-vim's table of digraphs  -*- lexical-binding: t -*-

;; Your Evil's `C-k' in insert state reads two keys and puts in their
;; digraph from `evil-digraphs-table': RFC 1345's mnemonics, with a few
;; more for characters in Unicode's private use area.  die-vim needs the
;; same table, so this prints it as Rust, from your Evil's sources, read
;; and never written.  Rerun it if your Evil's table changes:
;;
;;   EVIL_ORACLE_EVIL_DIR=~/.emacs.d/lisp/evil HOME=$(mktemp -d) \
;;     emacs -Q --batch -l tools/evil-oracle/oracle/digraphs.el > crates/die-vim/src/digraphs.rs
;;
;; Each entry is three characters: the two keys and what they make.  A
;; character that's a control, a space or a mark, or past the basic plane,
;; is written as an escape, so the source shows nothing it can't print.

(let ((dir (getenv "EVIL_ORACLE_EVIL_DIR")))
  (unless (and dir (file-exists-p (expand-file-name "evil-digraphs.el" dir)))
    (error "EVIL_ORACLE_EVIL_DIR must point at the Evil source directory"))
  (setq load-path (cons dir load-path)
        load-prefer-newer t
        native-comp-jit-compilation nil
        inhibit-automatic-native-compilation t))
(require 'evil-digraphs)

(defun digraphs-char (c)
  "C as it goes in a Rust string literal."
  (cond ((memq c '(?\" ?\\)) (string ?\\ c))
        ((or (< c #x21) (<= #x7f c #xa0) (> c #xffff)
             (memq (get-char-code-property c 'general-category) '(Mn Mc Me Zs Zl Zp Cc Cf Co Cs Cn)))
         (format "\\u{%x}" c))
        (t (string c))))

(princ "//! RFC 1345's digraphs, as your Evil's `evil-digraphs-table` has them, for `C-k`. Generated by\n")
(princ "//! tools/evil-oracle/oracle/digraphs.el from Evil's sources. Don't edit it by hand.\n\n")
(princ "/// Each digraph's two keys and what they make, three characters apiece, in your Evil's order.\n")
(princ "#[rustfmt::skip]\npub const TABLE: &str = \"\\\n")
(let ((col 0))
  (dolist (d evil-digraphs-table)
    (let ((s (concat (digraphs-char (nth 0 (car d))) (digraphs-char (nth 1 (car d)))
                     (digraphs-char (cdr d)))))
      (when (> (+ col (length s)) 96)
        (princ "\\\n")
        (setq col 0))
      (princ s)
      (setq col (+ col (length s))))))
(princ "\";\n")
