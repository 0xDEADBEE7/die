;;; word-scripts.el --- Write die-vim's table of word scripts and categories  -*- lexical-binding: t -*-

;; Emacs ends a word where two word characters differ in script
;; (`char-script-table'), unless `word-combining-categories' joins them,
;; and within one script where `word-separating-categories' splits them.
;; Your Evil binds both to its own lists (evil-cjk-word-*-categories).
;; die-vim needs each character's script and the categories those lists
;; name, so this prints them as Rust.  Rerun it if Emacs's tables change:
;;
;;   HOME=$(mktemp -d) emacs -Q --batch -l tools/evil-oracle/oracle/word-scripts.el \
;;     > crates/die-vim/src/scripts.rs
;;
;; A character that isn't a word character continues the range before it,
;; which keeps the table small: `class' in die-vim's text.rs decides those.
;; So does a combining mark in its own script's range, whatever its categories:
;; nothing in Evil's lists splits a mark from its script.  A mark starts a range
;; only when its script changes, because it can lead its script's block
;; (Devanagari starts with U+0900-0902), and it mustn't take the script before.

(defconst word-scripts-categories
  '((?r . "ROMAN") (?A . "FULL_WIDTH") (?G . "FULL_GREEK") (?k . "HALF_KANA")
    (?K . "KATAKANA") (?H . "HIRAGANA") (?C . "KANJI"))
  "The categories Evil's word lists name, other than combining marks.")

(defun word-scripts-mask (c)
  "The bits of C's categories in `word-scripts-categories'."
  (let ((set (char-category-set c)) (mask 0) (bit 1))
    (dolist (k word-scripts-categories)
      (when (aref set (car k)) (setq mask (logior mask bit)))
      (setq bit (ash bit 1)))
    mask))

(defun word-scripts-table ()
  "The ranges as (FIRST-CHAR SCRIPT-NUMBER MASK), and the scripts in order."
  (let ((scripts nil) (prev nil) (ranges nil))
    (with-syntax-table (standard-syntax-table)
      (dotimes (c (1+ (max-char 'unicode)))
        (when (eq (char-syntax c) ?w)
          (let* ((script (aref char-script-table c))
                 (mark (aref (char-category-set c) ?^))
                 (v (cons script (word-scripts-mask c))))
            (unless (or (equal v prev) (and mark (eq script (car prev))))
              (unless (memq script scripts) (setq scripts (append scripts (list script))))
              (push (list c (seq-position scripts script) (cdr v)) ranges)
              (setq prev v))))))
    (list (nreverse ranges) scripts)))

(pcase-let ((`(,ranges ,_scripts) (word-scripts-table)))
  (princ "//! Each word character's script and word categories, from Emacs's tables. Generated by\n")
  (princ (format "//! tools/evil-oracle/oracle/word-scripts.el with Emacs %s. Don't edit it by hand.\n\n"
                 emacs-version))
  (let ((bit 1))
    (dolist (k word-scripts-categories)
      (princ (format "pub const %s: u8 = %d;\n" (cdr k) bit))
      (setq bit (ash bit 1))))
  (princ "\n/// Each range's first character, its script (a number for each of Emacs's scripts)\n")
  (princ "/// and its categories, sorted. A character that isn't a word character in Emacs just\n")
  (princ "/// continues the range before it. So does a combining mark, unless its script changes.\n")
  (princ "#[rustfmt::skip]\npub const RANGES: &[(u32, u8, u8)] = &[\n")
  (let ((col 0))
    (dolist (r ranges)
      (let ((s (format "(0x%x,%d,%d)," (nth 0 r) (nth 1 r) (nth 2 r))))
        (when (> (+ col (length s)) 92)
          (princ "\n")
          (setq col 0))
        (princ (if (= col 0) "    " ""))
        (princ s)
        (setq col (+ col (length s))))))
  (princ "\n];\n"))
