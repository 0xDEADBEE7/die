{"topic": "shell",
 "cases": [
  {"id": "filter-all", "keys": ":%!sort<CR>", "text": ["c", "|a", "b"]},
  {"id": "filter-lines", "keys": ":2,3!sort<CR>", "text": ["|z", "c", "a", "b"]},
  {"id": "filter-line", "keys": ":.!tr a-z A-Z<CR>", "text": ["one", "t|wo", "three"]},
  {"id": "filter-visual", "keys": "Vj:!sort<CR>", "text": ["x", "|b", "a", "z"]},
  {"id": "filter-no-output", "description": "The line goes, with nothing in its place.", "keys": ":2!true<CR>", "text": ["a", "|b", "c"]},
  {"id": "filter-error-output", "description": "What the command says on stderr takes the line's place too.", "keys": ":.!echo oops 1>&2<CR>", "text": ["a", "|b", "c"]},
  {"id": "filter-undo", "keys": ":%!sort<CR>u", "text": ["c", "|a", "b"]},
  {"id": "filter-no-newline", "description": "Output with no newline at its end runs into the next line.", "keys": ":.!printf x<CR>", "text": ["a", "|b", "c"]},
  {"id": "filter-last-line-no-newline", "keys": ":.!printf x<CR>", "text": ["a", "b", "|c"]},
  {"id": "filter-previous", "description": ":.!! runs the last :! command again.", "keys": ":.!tr a-z A-Z<CR>j:.!!<CR>", "text": ["|ab", "cd", "ef"]},
  {"id": "filter-count", "keys": "2:!sort<CR>", "text": ["|b", "a", "c"]},
  {"id": "read-cmd", "keys": ":r !echo hi<CR>", "text": ["one", "t|wo", "three"]},
  {"id": "read-cmd-nospace", "keys": ":r!echo hi<CR>", "text": ["one", "t|wo", "three"]},
  {"id": "read-cmd-count", "keys": ":1r !echo hi<CR>", "text": ["one", "t|wo", "three"]},
  {"id": "read-cmd-zero", "keys": ":0r !echo hi<CR>", "text": ["one", "t|wo", "three"]},
  {"id": "read-cmd-two-lines", "description": "The cursor goes to the last line read.", "keys": ":r !printf 'x\\ny\\n'<CR>", "text": ["|one", "two"]},
  {"id": "read-cmd-no-newline", "keys": ":r !printf x<CR>", "text": ["|one", "two"]},
  {"id": "read-cmd-last-line", "keys": ":$r !echo hi<CR>", "text": ["|one", "two"]},
  {"id": "read-cmd-undo", "keys": ":r !echo hi<CR>u", "text": ["|one", "two"]},
  {"id": "shell-no-range", "description": "Without a range the text stays, and the output goes to the echo area.", "keys": ":!echo hi<CR>", "text": ["one", "t|wo"]},
  {"id": "bang-motion", "keys": "!jsort<CR>", "text": ["|b", "a", "z"]},
  {"id": "bang-bang", "keys": "!!tr a-z A-Z<CR>", "text": ["a", "|b", "c"]},
  {"id": "bang-visual", "keys": "vj!sort<CR>", "text": ["|b", "a", "z"]},
  {"id": "bang-up", "keys": "!ksort<CR>", "text": ["c", "|b", "a"]},
  {"id": "bang-empty", "keys": ":!<CR>", "text": ["|a"]},
  {"id": "bang-no-previous", "keys": ":.!!<CR>", "text": ["|a"]}
 ]}
