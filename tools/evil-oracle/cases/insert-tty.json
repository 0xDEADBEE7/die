{"topic": "insert-tty", "run": "tty",
 "defaults": {"window": {"width": 40, "height": 10}},
 "cases": [
  {"id": "down-down-keeps-column", "keys": "i<Down><Down>X<Esc>", "text": ["abcd|ef", "ab", "abcdef"]},
  {"id": "up-up-keeps-column", "keys": "i<Up><Up>X<Esc>", "text": ["abcdef", "ab", "abcd|ef"]},
  {"id": "down-once", "keys": "i<Down>X<Esc>", "text": ["abcd|ef", "ab", "abcdef"]},
  {"id": "goal-starts-at-the-session", "description": "The goal j kept in normal state doesn't carry into insert state", "keys": "ji<Down>X<Esc>", "text": ["abcd|ef", "ab", "abcdef"]},
  {"id": "typing-resets-the-goal", "keys": "i<Down>Y<Down>X<Esc>", "text": ["abcd|ef", "ab", "abcdef"]},
  {"id": "down-onto-the-last-empty-line", "vim": "end-line: Vim's second Down fails on the last line; Evil's moves past the final newline", "keys": "i<Down><Down>X<Esc>", "text": ["a|b", "cd"]},
  {"id": "down-past-the-end-fails", "vim": "end-line: Vim's second Down fails on the last line; Evil's moves past the final newline, and its third fails", "keys": "i<Down><Down><Down>X<Esc>", "text": ["a|b", "cd"]},
  {"id": "up-past-the-start-fails", "keys": "i<Up>X<Esc>", "text": ["a|b", "cd"]},
  {"id": "down-into-a-tab", "keys": "i<Down>X<Esc>", "text": ["abc|defgh", "\tij"]},
  {"id": "down-into-a-wide-char", "keys": "i<Down>X<Esc>", "text": ["a|bcdefgh", "日本語"]},
  {"id": "down-without-a-final-newline", "vim": "end-line: Vim's Down stays put on the last line; Evil's goes to the end of the text before it fails", "keys": "i<Down>X<Esc>", "text": "a|bc"},
  {"id": "down-past-the-last-row", "vim": "end-line: Vim's second Down stays put on the last line; Evil's goes to the end of the text before it fails", "keys": "i<Down><Down>X<Esc>", "text": "a|b\ncd"},
  {"id": "down-past-the-last-row-keeps-column", "keys": "i<Down><Up>X<Esc>", "text": "abcdef\nab|c"},
  {"id": "failed-right-clears-the-column", "vim": "goal: Vim's failed Right keeps the column; Evil's forgets it (Emacs's goal column)", "keys": "i<Down><Right><Up>X<Esc>", "text": "abcd|ef\nab"},
  {"id": "failed-left-clears-the-column", "vim": "goal: Vim's failed Left keeps the column; Evil's forgets it (Emacs's goal column)", "keys": "i<Up><Left><Down>X<Esc>", "text": "\nabc|d"},
  {"id": "failed-backspace-clears-the-column", "vim": "goal: Vim's failed Backspace keeps the column; Evil's forgets it (Emacs's goal column)", "keys": "i<Up><BS><Down>X<Esc>", "text": "\nabc|d"},
  {"id": "failed-ctrl-w-clears-the-column", "vim": "goal: Vim's failed C-w keeps the column; Evil's forgets it (Emacs's goal column)", "keys": "i<Up><C-w><Down>X<Esc>", "text": "\nabc|d"},
  {"id": "replace-up", "keys": "R<Up>x<Esc>", "text": ["ab", "c|d"]},
  {"id": "replace-down", "keys": "R<Down>x<Esc>", "text": ["a|b", "cd"]},
  {"id": "replace-up-dot", "keys": "R<Up>x<Esc>j.", "text": ["ab", "c|d", "ef"]},
  {"id": "replace-down-bs", "keys": "R<Down>x<BS><Esc>", "text": ["a|b", "cd"]},
  {"id": "replace-up-at-top-in-macro", "keys": "@a", "text": ["|ab"], "registers": {"a": {"text": "R<Up>x", "type": "macro"}}},
  {"id": "dot-fails-in-insert", "keys": "ix<Up>y<Esc>.", "text": ["ab", "|cd"]}
]}
