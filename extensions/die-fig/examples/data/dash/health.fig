{
  "type": "dashboard",
  "title": "Service health",
  "data": {
    "req": "requests.csv",
    "svc": "service.csv"
  },
  "time": { "field": "time", "range": "6h" },
  "rows": [
    [
      { "type": "stat", "label": "Requests", "data": "req", "value": { "sum": "total" },
        "trend": "time", "delta": "previous" },
      { "type": "stat", "label": "Error rate", "data": "svc", "value": { "mean": "error_rate" },
        "trend": "time", "delta": "previous", "good": "down", "format": ".2f" },
      { "type": "stat", "label": "p95 latency", "data": "svc", "value": { "p95": "p95_ms" },
        "trend": "time", "delta": "previous", "good": "down" },
      { "type": "stat", "label": "Active sessions", "data": "svc", "value": { "max": "sessions" },
        "trend": "time", "delta": "previous" }
    ],
    [
      { "type": "line", "title": "Requests per minute", "data": "req",
        "transform": [{ "fold": ["api", "worker"], "as": ["service", "rpm"] }],
        "x": "time", "y": { "field": "rpm", "title": "" }, "color": "service" },
      { "type": "area", "title": "Errors per minute", "subtitle": "all services", "data": "svc",
        "x": "time", "y": { "field": "errors", "title": "" } }
    ]
  ]
}
