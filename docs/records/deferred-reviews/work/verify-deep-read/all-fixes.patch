+        for _ in 0..1000 {
+            h.silent(Shift { pos: 1, del: 10, ins: 10 });
+        }
+        let status = top_group(&h.undo).1.len();
+        panic!("spinner shifts {spinner}, status-line shifts {status}");
+    }
