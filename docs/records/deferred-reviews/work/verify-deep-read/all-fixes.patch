+        let typed = || Op {
+            pos: 0,
+            removed: String::new(),
+            inserted: "x".into(),
+        };
+        // A spinner: one character at 5 rewritten in place.
+        let mut h = History::default();
+        h.record(typed(), None, 1, limit);
+        h.silent(Shift { pos: 1, del: 0, ins: 10 });
+        for _ in 0..1000 {
+            h.silent(Shift { pos: 5, del: 1, ins: 1 });
