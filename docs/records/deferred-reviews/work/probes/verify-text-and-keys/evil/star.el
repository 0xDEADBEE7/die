(setq load-prefer-newer t native-comp-jit-compilation nil inhibit-automatic-native-compilation t native-comp-enable-subr-trampolines nil)
(add-to-list 'load-path (expand-file-name "~/.emacs.d/lisp/evil"))
(setq evil-want-integration t evil-want-keybinding nil)
(require 'evil)
(evil-mode 1)
(dolist (case '(("x foo_bar foo" 11) ("x foo_bar foo" 2) ("foo foobar foo_bar" 0)))
  (with-current-buffer (get-buffer-create "s")
    (erase-buffer) (fundamental-mode) (evil-local-mode 1)
    (insert (car case)) (goto-char (1+ (cadr case))) (evil-normal-state)
    (switch-to-buffer (current-buffer))
    (let ((starts '()))
      (dotimes (_ 3)
        (execute-kbd-macro "*")
        (push (1- (point)) starts))
      (message "%S from %d: * lands at %S; pattern %S" (car case) (cadr case) (reverse starts) (car-safe evil-ex-search-pattern)))))
(with-current-buffer (get-buffer-create "w")
  (erase-buffer) (fundamental-mode) (evil-local-mode 1)
  (insert "foo_bar baz") (goto-char 1) (evil-normal-state) (switch-to-buffer (current-buffer))
  (execute-kbd-macro "w") (message "w from 0 in foo_bar baz -> %d" (1- (point))))
