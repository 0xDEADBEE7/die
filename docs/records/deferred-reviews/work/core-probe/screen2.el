;;; screen.el -- capture tty Emacs's screen through term.el  -*- lexical-binding: t -*-
(setq load-prefer-newer t native-comp-jit-compilation nil inhibit-automatic-native-compilation t native-comp-enable-subr-trampolines nil)
(require 'term)
(defvar screen-dir (file-name-directory (or load-file-name buffer-file-name)))
(defun screen-child ()
  (let ((mode (intern (getenv "LNUM"))))
    (set-frame-size (selected-frame) 30 14)
    (switch-to-buffer (get-buffer-create "t"))
    (fundamental-mode) (visual-line-mode 1)
    (setq display-line-numbers mode display-line-numbers-width 2)
    (insert "a\nb\nc\nd\ne\nf\n") (let ((o (make-overlay 3 8))) (overlay-put o (quote invisible) t))
    (goto-char (point-min)) ; cursor on "three"
    (redisplay t) (sit-for 0.5) (redisplay t)
    (with-temp-file (getenv "MARK") (insert "x"))
    (sit-for 3)
    (kill-emacs 0)))
(defun screen-main ()
  (let* ((emacs (expand-file-name invocation-name invocation-directory))
         (mark (make-temp-file "mark")) (buf (generate-new-buffer "term")))
    (delete-file mark)
    (add-hook 'term-mode-hook (lambda () (setq term-width 30 term-height 16)))
    (with-current-buffer buf
      (let ((process-environment (append (list "TERM=eterm-color" (concat "TERMINFO=" data-directory "e")
                                               (concat "MARK=" mark) (concat "LNUM=" (getenv "LNUM")))
                                         process-environment)))
        (let ((proc (make-process :name "c" :buffer buf :connection-type 'pty :noquery t
                                  :command `("sh" "-c" "stty rows 16 cols 30 && exec \"$@\"" "sh" ,emacs "-Q" "-nw"
                                             "-l" ,(expand-file-name "screen2.el" screen-dir) "-f" "screen-child"))))
          (term-mode)
          (setq term-width 30 term-height 16)
          (term--reset-scroll-region)
          (setq term-home-marker (copy-marker 0))
          (set-marker (process-mark proc) (point))
          (set-process-filter proc #'term-emulate-terminal)
          (let ((deadline (+ (float-time) 20)))
            (while (and (not (file-exists-p mark)) (< (float-time) deadline))
              (accept-process-output proc 0.05)))
          (accept-process-output proc 0.3)
          (princ (format "size %d status %s\n" (buffer-size) (process-status proc)))
          (princ (buffer-substring-no-properties (point-min) (point-max)))
          (princ "\n----\n")
          (delete-process proc))))))
