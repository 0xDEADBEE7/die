;; Check that combining marks (category ^) carry none of the other categories
;; Evil's word rules name, and count ranges with marks as one script of their own.
(defconst cats '(?r ?A ?G ?k ?K ?H ?C))
(defun mask (c)
  (let ((set (char-category-set c)) (m 0) (i 0))
    (dolist (k cats) (when (aref set k) (setq m (logior m (ash 1 i)))) (setq i (1+ i)))
    m))
(let ((bad 0) (prev nil) (n 0) (marks-not-M 0) (M-not-marks 0))
  (dotimes (c #x110000)
    (let* ((set (char-category-set c))
           (gc (get-char-code-property c 'general-category))
           (markp (aref set ?^))
           (word (or (eq (char-syntax c) ?w) markp))
           (v (and word (if markp 'mark (cons (aref char-script-table c) (mask c))))))
      (when (and markp (/= 0 (mask c))) (setq bad (1+ bad)) (when (< bad 10) (princ (format "mark with cats: %X %s\n" c (category-set-mnemonics set)))))
      (when (and markp (not (memq gc '(Mn Mc Me)))) (setq marks-not-M (1+ marks-not-M)))
      (when (and (memq gc '(Mn Mc Me)) (not markp)) (setq M-not-marks (1+ M-not-marks)))
      (unless (or (null v) (equal v prev)) (setq n (1+ n)) (setq prev v))))
  (princ (format "marks with other cats %d, ranges %d, ^ not M %d, M not ^ %d\n" bad n marks-not-M M-not-marks)))
