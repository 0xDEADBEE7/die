;; Ranges of (script, categories) over word characters that aren't marks; every
;; other character continues the range before it.
(defconst cats '(?r ?A ?G ?k ?K ?H ?C))
(defun mask (c)
  (let ((set (char-category-set c)) (m 0) (i 0))
    (dolist (k cats) (when (aref set k) (setq m (logior m (ash 1 i)))) (setq i (1+ i)))
    m))
(let ((prev nil) (n 0) (marks 0) (pm nil) (scripts nil) (nm 0))
  (dotimes (c #x110000)
    (let* ((set (char-category-set c))
           (markp (and (aref set ?^) (not (memq c '(#x3099 #x309a)))))
           (word (and (eq (char-syntax c) ?w) (not markp)))
           (v (and word (cons (aref char-script-table c) (mask c)))))
      (when (and v (not (equal v prev))) (setq n (1+ n)) (setq prev v)
            (unless (memq (car v) scripts) (push (car v) scripts)))
      (unless (eq markp pm) (when markp (setq nm (1+ nm))) (setq pm markp))))
  (princ (format "ranges %d scripts %d mark-ranges %d\n" n (length scripts) nm)))
