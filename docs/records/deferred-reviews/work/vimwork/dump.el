(let ((n 0) (scripts nil))
  (map-char-table
   (lambda (k v)
     (setq n (1+ n))
     (unless (memq v scripts) (push v scripts)))
   char-script-table)
  (princ (format "ranges %d scripts %d\n" n (length scripts)))
  (princ (format "%S\n" (mapcar (lambda (c) (cons c (aref char-script-table c)))
                                (list ?a #x301 ?α ?ŝ ?é ?ἀ #xff21 #xff71 ?1 ?١ ?_ ?. #x1F600)))))
(princ (format "cats a=%s 0301=%s alpha=%s ff21=%s ff71=%s 30a2=%s 3042=%s 65e5=%s\n"
               (category-set-mnemonics (char-category-set ?a))
               (category-set-mnemonics (char-category-set #x301))
               (category-set-mnemonics (char-category-set ?α))
               (category-set-mnemonics (char-category-set #xff21))
               (category-set-mnemonics (char-category-set #xff71))
               (category-set-mnemonics (char-category-set #x30a2))
               (category-set-mnemonics (char-category-set #x3042))
               (category-set-mnemonics (char-category-set #x65e5))))
