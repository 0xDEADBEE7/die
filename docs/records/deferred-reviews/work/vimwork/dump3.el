;; How many ranges each category bit costs, over word-syntax characters and marks.
(defconst cats '(?r ?A ?G ?k ?K ?H ?C ?^))
(defun mask (c only)
  (let ((set (char-category-set c)) (m 0) (i 0))
    (dolist (k cats) (when (and (memq k only) (aref set k)) (setq m (logior m (ash 1 i)))) (setq i (1+ i)))
    m))
(defun count (only)
  (let ((prev nil) (n 0))
    (dotimes (c #x110000)
      (let* ((word (or (eq (char-syntax c) ?w)
                       (memq (get-char-code-property c 'general-category) '(Mn Mc Me))))
             (v (and word (cons (aref char-script-table c) (mask c only)))))
        (unless (or (null v) (equal v prev)) (setq n (1+ n)) (setq prev v))))
    n))
(princ (format "none %d\n" (count nil)))
(dolist (k cats)
  (princ (format "only %c: %d\n" k (count (list k)))))
(princ (format "all but C: %d\n" (count (remq ?C cats))))
(princ (format "all: %d\n" (count cats)))
