;;; screen4.el -- where tty Emacs really draws its cursor, and a fold's numbers  -*- lexical-binding: t -*-
;; Adapted from set2's screen3.el. A child `emacs -Q -nw' on a private pty, read through term.el.
(setq load-prefer-newer t native-comp-jit-compilation nil inhibit-automatic-native-compilation t native-comp-enable-subr-trampolines nil)
(require 'term)
(require 'subr-x)
(defvar screen-dir (file-name-directory (or load-file-name buffer-file-name)))
(defun screen-child ()
  (let ((mode (getenv "LNUM"))
        (text (replace-regexp-in-string "@" "\n" (getenv "TEXTC")))
        (cur (string-to-number (getenv "CURC")))
        (fold (getenv "FOLD")))
    (menu-bar-mode -1)
    (set-frame-size (selected-frame) (string-to-number (getenv "COLSC")) 14)
    (switch-to-buffer (get-buffer-create "t"))
    (fundamental-mode) (visual-line-mode 1)
    (unless (string-empty-p mode)
      (setq display-line-numbers (intern mode) display-line-numbers-width 2))
    (insert text)
    (unless (string-empty-p fold)
      (let ((o (make-overlay 3 8))) (overlay-put o 'invisible t)))
    (goto-char (1+ cur))
    (redisplay t) (sit-for 0.5) (redisplay t)
    (with-temp-file (getenv "MARK") (insert "x"))
    (sit-for 3)
    (kill-emacs 0)))
(defun screen-main ()
  (let* ((emacs (expand-file-name invocation-name invocation-directory))
         (mark (make-temp-file "mark")) (buf (generate-new-buffer "term"))
         (cols (getenv "COLSC")))
    (delete-file mark)
    (with-current-buffer buf
      (let ((process-environment (append (list "TERM=eterm-color" (concat "TERMINFO=" data-directory "e")
                                               (concat "MARK=" mark))
                                         process-environment)))
        (let ((proc (make-process :name "c" :buffer buf :connection-type 'pty :noquery t
                                  :command `("sh" "-c" ,(format "stty rows 16 cols %s && exec \"$@\"" cols) "sh" ,emacs "-Q" "-nw"
                                             "-l" ,(expand-file-name "screen4.el" screen-dir) "-f" "screen-child"))))
          (term-mode)
          (setq term-width (string-to-number cols) term-height 16)
          (term--reset-scroll-region)
          (setq term-home-marker (copy-marker 0))
          (set-marker (process-mark proc) (point))
          (set-process-filter proc #'term-emulate-terminal)
          (let ((deadline (+ (float-time) 20)))
            (while (and (not (file-exists-p mark)) (< (float-time) deadline))
              (accept-process-output proc 0.05)))
          (accept-process-output proc 0.3)
          (princ (format "== lnum=%s cur=%s text=%S cursor row=%d col=%d\n" (getenv "LNUM") (getenv "CURC") (getenv "TEXTC")
                         (term-current-row) (term-current-column)))
          (let* ((s (buffer-substring-no-properties (point-min) (point-max)))
                 (lines (split-string s "\n")))
            (dolist (l lines) (unless (string-blank-p l) (princ (concat l "|\n")))))
          (delete-process proc))))))
